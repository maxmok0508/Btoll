<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>local.bsstoll.fan-helper</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/local.bsstoll.fan-helper</string>
		<string>serve</string>
		<string>501</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/bsstoll-fan.log</string>
	<key>StandardOutPath</key>
	<string>/var/log/bsstoll-fan.log</string>
	<key>ThrottleInterval</key>
	<integer>5</integer>
</dict>
</plist>
